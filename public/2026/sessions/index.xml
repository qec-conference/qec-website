    <item>
      <title>Business Meeting</title>
      <link>http://localhost:56121/2026/sessions/business/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:56121/2026/sessions/business/</guid>
      <description>&lt;p&gt;We will discuss any pressing business for the conference, cover the financials and operations of QEC26, and announce the hosts for QEC27. All are welcome to attend!&lt;/p&gt;</description>
    </item>
    <item>
